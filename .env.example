# Copy to .env and fill in.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=finwise

# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat that receives questions the bot can't answer (your private chat with the bot, or a group the
# bot is in). Send /chatid to the bot from that chat to get the id. Group ids are negative.
TELEGRAM_ADMIN_CHAT_ID=

# --- LLM ---
# openai (OpenAI or any OpenAI-compatible API)  |  anthropic (Claude)
LLM_PROVIDER=openai
LLM_HISTORY_TURNS=6

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=
# Your API URL, usually ending in /v1 (e.g. https://your-server.com/v1). Leave empty for api.openai.com
OPENAI_BASE_URL=https://api.metisai.ir/openai/v1
OPENAI_MODEL=gpt-4o-mini

# Claude (only used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high
ANTHROPIC_EFFORT=low

# --- RAG (hybrid BM25 + vector search) ---
# false = put the whole knowledge base in every prompt instead of retrieving passages
RAG_ENABLED=true
# Passages sent to the LLM per question / candidates per retriever before rank fusion
RAG_TOP_K=6
RAG_CANDIDATES=12
# Embedding model on an OpenAI-compatible /embeddings endpoint. Key and URL default to the
# OPENAI_* values above (needed even when LLM_PROVIDER=anthropic). If embeddings fail, the bot
# falls back to keyword (BM25) search only.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Crawler ---
CRAWLER_BASE_URL=https://finwisecenter.com/
